# The Workers Builds image installs with npm 10 on Linux. `workerd` ships its
# binary as a platform optionalDependency — a ~127 MB tarball for
# `@cloudflare/workerd-linux-64` — and npm treats optional dependencies as
# best-effort: if that download fails it carries on with the install, and only
# fails later inside `vinext build` with
#
#   The package "@cloudflare/workerd-linux-64" could not be found,
#   and is needed by workerd.
#
# which reads like a missing dependency rather than a failed download. Observed
# on #102: one build of a commit installed 537 packages and passed, the next
# commit (same lockfile, same npm) installed 535 and failed.
#
# Tracked in #104 — this is a mitigation, not a fix.
#
# These raise the ceiling on npm's retries so the big binary has room to
# succeed. They are additive — npm's defaults are fetch-retries=2,
# fetch-retry-maxtimeout=60000, fetch-timeout=300000.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=600000
